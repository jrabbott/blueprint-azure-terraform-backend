{
  "$schema": "https://schema.microsoft.com/schemas/2018-05-01/subscriptionDeploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "resourceGroupName": { "type": "string", "defaultValue": "rg-terraform-mgmt" },
    "location": { "type": "string", "defaultValue": "westeurope" },
    "storageAccountName": { "type": "string" },
    "storageAccountSku": { "type": "string", "defaultValue": "Standard_ZRS" },
    "principalId": { "type": "string" },
    "workspaceName": { "type": "string", "defaultValue": "law-terraform-mgmt" },
    "tags": { "type": "object", "defaultValue": { "Env": "Prod", "ManagedBy": "ARM" } }
  },
  "resources": [
    {
      "type": "Microsoft.Resources/resourceGroups",
      "apiVersion": "2021-04-01",
      "name": "[parameters('resourceGroupName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]"
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2021-04-01",
      "name": "innerDeployment",
      "resourceGroup": "[parameters('resourceGroupName')]",
      "dependsOn": [ "[subscriptionResourceId('Microsoft.Resources/resourceGroups', parameters('resourceGroupName'))]" ],
      "properties": {
        "mode": "Incremental",
        "parameters": {
          "tags": { "value": "[parameters('tags')]" },
          "storageAccountName": { "value": "[parameters('storageAccountName')]" },
          "storageAccountSku": { "value": "[parameters('storageAccountSku')]" },
          "location": { "value": "[parameters('location')]" },
          "principalId": { "value": "[parameters('principalId')]" },
          "workspaceName": { "value": "[parameters('workspaceName')]" }
        },
        "template": {
          "$schema": "https://schema.microsoft.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "resources": [
            {
              "type": "Microsoft.Storage/storageAccounts",
              "apiVersion": "2023-01-01",
              "name": "[parameters('storageAccountName')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "sku": { "name": "[parameters('storageAccountSku')]" },
              "kind": "StorageV2",
              "properties": { "allowSharedKeyAccess": false, "supportsHttpsTrafficOnly": true }
            },
            {
              "type": "Microsoft.Storage/storageAccounts/blobServices",
              "apiVersion": "2023-01-01",
              "name": "[concat(parameters('storageAccountName'), '/default')]",
              "dependsOn": [ "[parameters('storageAccountName')]" ],
              "properties": { 
                "isVersioningEnabled": true,
                "deleteRetentionPolicy": {
                  "enabled": true,
                  "days": 14
                },
                "containerDeleteRetentionPolicy": {
                  "enabled": true,
                  "days": 14
                }
              }
            },
            {
              "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
              "apiVersion": "2023-01-01",
              "name": "[concat(parameters('storageAccountName'), '/default/tfstate')]",
              "dependsOn": [ "[concat(parameters('storageAccountName'), '/default')]" ]
            },
            {
              "type": "Microsoft.OperationalInsights/workspaces",
              "apiVersion": "2021-06-01",
              "name": "[parameters('workspaceName')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "properties": { "sku": { "name": "PerGB2018" } }
            },
            {
              "type": "Microsoft.Storage/storageAccounts/blobServices/providers/diagnosticSettings",
              "apiVersion": "2021-05-01-preview",
              "name": "[concat(parameters('storageAccountName'), '/default/Microsoft.Insights/default')]",
              "dependsOn": [
                "[concat(parameters('storageAccountName'), '/default')]",
                "[parameters('workspaceName')]"
              ],
              "properties": {
                "workspaceId": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName'))]",
                "logs": [
                  {
                    "category": "StorageRead",
                    "enabled": true
                  },
                  {
                    "category": "StorageWrite",
                    "enabled": true
                  },
                  {
                    "category": "StorageDelete",
                    "enabled": true
                  }
                ]
              }
            },
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "name": "[guid(parameters('storageAccountName'), parameters('principalId'), 'ba92f5b4-2d11-453d-a403-e96b0029c9fe')]",
              "scope": "[concat('Microsoft.Storage/storageAccounts/', parameters('storageAccountName'))]",
              "dependsOn": [ "[parameters('storageAccountName')]" ],
              "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'ba92f5b4-2d11-453d-a403-e96b0029c9fe')]",
                "principalId": "[parameters('principalId')]",
                "principalType": "ServicePrincipal"
              }
            },
            {
              "type": "Microsoft.Authorization/locks",
              "apiVersion": "2017-04-01",
              "name": "StateLock",
              "scope": "[concat('Microsoft.Storage/storageAccounts/', parameters('storageAccountName'))]",
              "dependsOn": [ "[parameters('storageAccountName')]" ],
              "properties": { "level": "CanNotDelete" }
            }
          ]
        }
      }
    }
  ]
}